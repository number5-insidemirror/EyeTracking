# ==========================
# macOS 시스템 파일
# ==========================
# Finder가 자동 생성하는 메타데이터 파일
.DS_Store
.DS_Store?
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ==========================
# Python
# ==========================
# 바이트코드 캐시 (실행 시 자동 생성됨)
__pycache__/
*.py[cod]
*$py.class

# 가상환경 디렉토리
.venv/
venv/
env/

# 배포/패키징
*.egg-info/
dist/
build/

# ==========================
# IDE / 에디터
# ==========================
# JetBrains (PyCharm 등)
.idea/

# VS Code
.vscode/

# ==========================
# 대용량 모델 / 데이터 파일
# ==========================
# 학습된 모델 가중치 (Git에 올리기엔 너무 큼, 별도 공유 권장)
*.pth
*.dat

# 수집된 학습/테스트 데이터셋 디렉토리
dataset*/
추가데이터_연구실/

# 시각화 결과물 디렉토리
result*/

# ==========================
# 기타
# ==========================
# Jupyter Notebook 체크포인트
.ipynb_checkpoints/

# 로그 파일
*.log
